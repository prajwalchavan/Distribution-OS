# Copy to .env (git-ignored). Every app reads the same file from the repo root.
NODE_ENV=development
PORT=3000

# Local Postgres from `pnpm db:up` (docker) or your own server.
DATABASE_URL=postgres://dos:dos@localhost:5432/dos

# Role the API/worker connect as at runtime (RLS applies to it). Migrations use DATABASE_URL.
APP_DB_ROLE=app_rw

# Anthropic API key for document intelligence (invoice extraction). Leave empty until that module exists.
ANTHROPIC_API_KEY=

# MSG91 / WhatsApp / maps keys are added when those modules are built.
