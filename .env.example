# Copy to .env (git-ignored). Every app reads the same file from the repo root.
NODE_ENV=development
# Each backend service has its own default port (owner 3001, sales 3002, warehouse 3003, delivery 3004, retailer 3005); override with e.g. OWNER_SERVICE_PORT=

# Local Postgres 17: Homebrew service on 5439 (founder machine) or `pnpm db:up` (docker, 5432).
DATABASE_URL=postgres://dos:dos@127.0.0.1:5439/dos

# Role the API/worker connect as at runtime (RLS applies to it). Migrations use DATABASE_URL.
APP_DB_ROLE=app_rw

# Anthropic API key for document intelligence (invoice extraction). Leave empty until that module exists.
ANTHROPIC_API_KEY=

# MSG91 / WhatsApp / maps keys are added when those modules are built.
