# The service this app talks to (docs/18 build log has the port per role) and the auth service that
# issues the tokens. Expo inlines any EXPO_PUBLIC_* variable into the bundle at build time, so these
# are the two knobs that point a build at local, staging or production.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3007
EXPO_PUBLIC_AUTH_URL=http://127.0.0.1:3000

# Where a DISTRIBUTOR's own service lives. Nothing is read from it without an owner-approved support
# window; the console sends the `x-support-grant` pass there and their service audits every call.
EXPO_PUBLIC_TENANT_API_URL=http://127.0.0.1:3001

# All-in-one deployment (docs/26 §7): every service behind one origin, each under its own prefix.
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3100
# EXPO_PUBLIC_API_PREFIX=/admin
