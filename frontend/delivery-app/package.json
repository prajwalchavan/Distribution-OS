{
  "name": "@dos/delivery-app",
  "version": "0.0.0",
  "private": true,
  "description": "Distribution OS - Delivery: one Expo codebase shipping as website, Android and iOS (docs/08 §0). Talks to its own service on :3005.",
  "main": "expo-router/entry",
  "scripts": {
    "web": "node ./scripts/sync-fonts.mjs && expo start --web --port 5177",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "native:prebuild": "expo prebuild",
    "export:web": "node ./scripts/sync-fonts.mjs && expo export --platform web --output-dir dist",
    "build": "node ./scripts/sync-fonts.mjs && expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .expo",
    "sync:fonts": "node ./scripts/sync-fonts.mjs"
  },
  "dependencies": {
    "@dos/api-client": "workspace:*",
    "@dos/contracts": "link:../../backend/libs/contracts",
    "@dos/domain": "link:../../backend/libs/domain",
    "@dos/offline": "workspace:*",
    "@dos/ui": "workspace:*",
    "@expo/metro-runtime": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "expo": "catalog:",
    "expo-camera": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-document-picker": "catalog:",
    "expo-file-system": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-linking": "catalog:",
    "expo-location": "catalog:",
    "expo-print": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sharing": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-task-manager": "catalog:",
    "expo-web-browser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
