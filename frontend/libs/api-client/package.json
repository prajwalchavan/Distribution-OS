{
  "name": "@dos/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed oRPC client for the Distribution OS contract: token storage, transparent refresh, typed errors, idempotent mutations, and a small React layer (ApiProvider, useSession, useQuery/useMutation)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dos/contracts": "link:../../../backend/libs/contracts",
    "@dos/domain": "link:../../../backend/libs/domain",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@dos/config": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
