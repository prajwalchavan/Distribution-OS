{
  "name": "@dos/app-template",
  "version": "0.0.0",
  "private": true,
  "description": "The universal-app skeleton every Distribution OS role app is generated from (docs/08 \u00a70): one Expo codebase that ships as website + Android + iOS, screens written only against the @dos/ui contract.",
  "main": "expo-router/entry",
  "scripts": {
    "new": "node ./scripts/new-app.mjs",
    "web": "expo start --web --port ${PORT:-5170}",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "native:prebuild": "expo prebuild",
    "export:web": "expo export --platform web --output-dir dist",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .expo"
  },
  "dependencies": {
    "@dos/api-client": "workspace:*",
    "@dos/contracts": "link:../../../backend/libs/contracts",
    "@dos/domain": "link:../../../backend/libs/domain",
    "@dos/offline": "workspace:*",
    "@dos/ui": "workspace:*",
    "@expo/metro-runtime": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "expo": "catalog:",
    "expo-camera": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-document-picker": "catalog:",
    "expo-file-system": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-linking": "catalog:",
    "expo-location": "catalog:",
    "expo-print": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sharing": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-task-manager": "catalog:",
    "expo-web-browser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@dos/config": "workspace:*",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
