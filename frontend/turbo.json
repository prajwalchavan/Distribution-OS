{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_AUTH_URL",
    "EXPO_PUBLIC_API_PREFIX"
  ],
  "globalDependencies": ["libs/config/tsconfig/base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**"]
    },
    "export:web": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "web": {
      "cache": false,
      "persistent": true
    },
    "ios": {
      "cache": false,
      "persistent": true
    },
    "android": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "@dos/offline#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/dos-app/app/**",
        "$TURBO_ROOT$/dos-app/src/**",
        "$TURBO_ROOT$/admin-app/app/**",
        "$TURBO_ROOT$/admin-app/src/**"
      ]
    },
    "@dos/ui#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/dos-app/app/**",
        "$TURBO_ROOT$/dos-app/src/**",
        "$TURBO_ROOT$/admin-app/app/**",
        "$TURBO_ROOT$/admin-app/src/**"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
