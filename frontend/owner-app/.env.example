# Copy to .env.local to point the app at services somewhere other than this machine.
# Left unset, the app calls its own origin and Vite proxies (see vite.config.ts):
#   /api/*   -> owner-service  http://127.0.0.1:3001   (the /api prefix is stripped)
#   /auth/*  -> auth-service   http://127.0.0.1:3000   (forwarded as-is; routes already start with /auth)

# Base URL of owner-service. Its routes carry no prefix, so include one only if your proxy adds it.
VITE_API_URL=
# Origin of auth-service. NO trailing /auth: the contract routes already start with /auth.
VITE_AUTH_URL=
