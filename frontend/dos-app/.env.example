# The one app talks to SIX services, one per group, and to the auth service that issues the tokens.
# Expo inlines any EXPO_PUBLIC_* variable into the bundle at build time.
EXPO_PUBLIC_AUTH_URL=http://127.0.0.1:3000

# ALL-IN-ONE deployment (docs/26 §7): every service behind ONE origin, each under its own prefix
# (/owner, /manager, /sales, /warehouse, /delivery, /retailer). Set the base and `serviceFor()`
# appends the elected group's prefix — one variable for all six.
# EXPO_PUBLIC_API_URL=https://api.distributionos.in
#
# Against `pnpm --filter @dos/all-in-one dev` on this Mac (:3100) the auth URL gains the prefix too,
# because auth-service is mounted at /auth there while its own routes already begin with /auth:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:3100
#   EXPO_PUBLIC_AUTH_URL=http://127.0.0.1:3100/auth

# UNSET (this Mac): each group talks to its own port — owner 3001, manager 3002, sales 3003,
# warehouse 3004, delivery 3005, retailer 3006. Leave it out rather than pointing it at one service:
# a single per-app service URL is exactly what the merge removed (docs/31 §2, R10).
