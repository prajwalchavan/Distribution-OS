# Every variable the production box needs, in one file. `./gen-secrets.sh` writes the real
# `.env.prod` from this one with fresh keys; `.env.prod` is git-ignored and must never be committed
# (the repo's .gitignore already refuses `.env.*`, and infra/.gitignore re-admits only this example).
#
# Compose reads it twice and for two different reasons: the `${...}` substitutions below (image tag,
# domain, database password) are resolved by compose itself from `--env-file`/the shell, and the whole
# file is handed to the app and migrate containers as `env_file`. That is why the deployment knobs and
# the application's own configuration sit together here.
#
# The values below are PLACEHOLDERS. Every one of them is wrong for a real box on purpose: the file
# must resolve so `docker compose config` can check the shape, and must not be usable as-is.

# ---------------------------------------------------------------- compose: what to run, and where
# Built and pushed by .github/workflows/image.yml. Pin a tag, never `latest`, so a reboot cannot
# quietly move the box to a newer build; the runbook's rollback is this line plus `up -d`.
DOS_IMAGE=ghcr.io/prajwalchavan/distribution-os:sha-0000000
# The domain bought for the pilot (docs/22 §8, 2026-09-21). The API answers on api.<DOMAIN>.
DOMAIN=distributionos.in
# Let's Encrypt writes to this address when a certificate is about to expire. A real mailbox.
ACME_EMAIL=founder@example.in
# Where Caddy sends the traffic: the app service on the compose network, on the all-in-one port.
APP_UPSTREAM=app:3100

# ---------------------------------------------------------------- the database container
POSTGRES_USER=dos
POSTGRES_PASSWORD=replace-me-gen-secrets-writes-a-real-one
POSTGRES_DB=dos

# ---------------------------------------------------------------- the application (docs/26 §2)
NODE_ENV=production
# `db` is the compose service name, not localhost: the app and the database are separate containers.
DATABASE_URL=postgres://dos:replace-me-gen-secrets-writes-a-real-one@db:5432/dos
DATABASE_REPLICA_URL=
APP_DB_ROLE=app_rw
# Per mounted service. All-in-one mounts eight and the worker opens one more pool: 9 x 4 = 36, and
# the db container is started with max_connections=100.
DATABASE_POOL_MAX=4

# All-in-one mode: every service behind its path prefix on one port, worker in the same process.
DOS_MODE=all
WORKER_INLINE=1
ALL_IN_ONE_PORT=3100
HEALTH_PORT=3100

# EdDSA key pair for access tokens — `pnpm auth:keygen` prints both lines, and gen-secrets.sh runs it.
# One pair per environment, never shared with dev, never in git.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30

# The browser origins allowed to call the API. The web apps are on Cloudflare Pages, so these are
# Pages hostnames and the app subdomain — NOT api.<DOMAIN>, which is the API's own origin.
# It MUST be set outside development: empty means "any localhost", which is a development shortcut.
CORS_ORIGINS=https://app.distributionos.in

# Object storage. `local` keeps bytes on the box under OBJECT_STORAGE_DIR (a compose volume); switch
# to `s3` with the four OBJECT_STORAGE_S3_* lines when the files outgrow the disk.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_DIR=/data/storage
OBJECT_STORAGE_URL_TTL_SECONDS=900
# HMAC secret for the local driver's signed /storage URLs. REQUIRED when NODE_ENV=production.
OBJECT_STORAGE_SIGNING_SECRET=
# Absolute origin to prefix those signed URLs with, so a phone on mobile data can fetch them.
OBJECT_STORAGE_PUBLIC_URL=https://api.distributionos.in
OBJECT_STORAGE_S3_BUCKET=
OBJECT_STORAGE_S3_REGION=ap-south-1
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_ACCESS_KEY_ID=
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=

# Document intelligence. `stub` until the founder decides to pay per page: it is deterministic and
# calls nothing. Setting ANTHROPIC_API_KEY alone does not switch it — DOCINT_ENGINE does.
DOCINT_ENGINE=stub
ANTHROPIC_API_KEY=
DOCINT_INLINE_JOBS=0
OUTBOX_MAX_ATTEMPTS=8

# ---------------------------------------------------------------- the first distributor (bootstrap)
# Used ONCE, by `docker compose run --rm app bootstrap`, to create the tenant and its owner. This is
# NOT `pnpm db:seed`: no demo staff, no demo shops, no demo orders (docs/23 §10).
TENANT_SLUG=tarsun
TENANT_LEGAL_NAME=M/s. Tarsun Enterprise
TENANT_GSTIN=
TENANT_STATE_CODE=27
TENANT_PLAN=pilot
OWNER_NAME=Owner Name
OWNER_USERNAME=owner.tarsun
OWNER_PHONE=+919000000001
# At least 12 characters. gen-secrets.sh writes a random one; hand it to the owner out of band and
# have them change it at first sign-in.
OWNER_PASSWORD=

# ---------------------------------------------------------------- backups (backup.sh / restore.sh)
# Any S3-compatible endpoint. Cloudflare R2 is the decided one (zero egress fees, 10 GB free):
# https://<accountid>.r2.cloudflarestorage.com, a bucket, and an R2 API token scoped to that bucket.
BACKUP_S3_ENDPOINT=https://0000000000000000.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=dos-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Where the local copies live before they are uploaded, and how many are kept on the box.
BACKUP_DIR=/var/backups/dos
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
