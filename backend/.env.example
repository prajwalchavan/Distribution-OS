# Copy to backend/.env (git-ignored). Every service and the worker read it through loadDotenv(): the file
# nearest to the process's working directory wins, so a service may carry its own .env to override this one.
NODE_ENV=development
# Default ports: auth 3000, owner 3001, manager 3002, sales 3003, warehouse 3004, delivery 3005, retailer 3006.
# Override one with <NAME>_SERVICE_PORT, e.g. OWNER_SERVICE_PORT=4001. Never set a global PORT.

# Local Postgres 17 (Homebrew service on 5439 on the founder's Mac, or `pnpm db:up` for the docker one on 5432).
DATABASE_URL=postgres://dos:dos@127.0.0.1:5439/dos
# Optional read replica for reports and lists (docs/20). Falls back to DATABASE_URL when empty.
DATABASE_REPLICA_URL=

# Role the services and worker connect as at runtime (RLS applies to it). Migrations and seeds use DATABASE_URL's role.
APP_DB_ROLE=app_rw

# Auth service: EdDSA key pair for access tokens. `pnpm auth:keygen` prints both lines.
# Every service needs the public key; only auth-service needs the private key.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30

# Browser origins allowed to call the services (comma separated), e.g. https://app.example.com
# Empty in development = any localhost port; it MUST be set in production.
CORS_ORIGINS=

# Object storage (invoice/challan PDFs, POD photos, claim evidence, imports and exports).
# `local` is the default and needs no cloud account: bytes land under OBJECT_STORAGE_DIR and a create
# call carries them inline (putUrl answers url:null, inline:true). Switch to `s3` in production.
OBJECT_STORAGE_DRIVER=local
# Where the local driver writes. Default: backend/.storage (git-ignored).
OBJECT_STORAGE_DIR=
# How long a getUrl / pre-signed putUrl stays valid.
OBJECT_STORAGE_URL_TTL_SECONDS=900
# HMAC secret for the local driver's signed /storage URLs. Required when NODE_ENV=production.
OBJECT_STORAGE_SIGNING_SECRET=
# Absolute origin to prefix local storage URLs with, e.g. https://api.example.com. Empty = relative.
OBJECT_STORAGE_PUBLIC_URL=
# s3 driver only. ENDPOINT overrides the derived https://<bucket>.s3.<region>.amazonaws.com
# (set it for any S3-compatible store). Credentials fall back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
OBJECT_STORAGE_S3_BUCKET=
OBJECT_STORAGE_S3_REGION=ap-south-1
OBJECT_STORAGE_S3_ENDPOINT=
OBJECT_STORAGE_S3_ACCESS_KEY_ID=
OBJECT_STORAGE_S3_SECRET_ACCESS_KEY=
OBJECT_STORAGE_S3_SESSION_TOKEN=

# Anthropic API key for document intelligence (invoice extraction). Leave empty until that module exists.
ANTHROPIC_API_KEY=

# MSG91 / WhatsApp / maps keys are added when those modules are built.

# Document intelligence (docint): the inbound-bill pipeline (capture → QR → engine → checks → SKU match → review).
# DOCINT_ENGINE: `stub` (deterministic, no network; the default in tests and whenever ANTHROPIC_API_KEY is
# empty) or `anthropic` (vision on the Messages API, never auto-commits). Models are used exactly as named.
DOCINT_ENGINE=stub
DOCINT_MODEL=claude-sonnet-5
DOCINT_ESCALATION_MODEL=claude-opus-5
# Run the four pipeline steps inside `documents.submit` / `extractions.run` instead of the worker's pg-boss
# queues (docint.qr-read / extract / validate / match). On in tests; on here for the local demo.
DOCINT_INLINE_JOBS=1
# Escalate to the secondary engine automatically when a reading fails two arithmetic checks (docs/05 step 7).
DOCINT_AUTO_ESCALATE=1
# Engine attempts before a document is `failed` and manual typing is allowed; the review lock TTL in seconds.
DOCINT_MAX_ATTEMPTS=3
DOCINT_LOCK_TTL_SECONDS=300
# Optional JWKS (JSON) of the IRP's e-invoice signing keys; without it a QR is `decoded`, never `verified`.
DOCINT_IRP_KEYS=
# Cost accounting on extractions.cost_paise (USD per million tokens; rupee rate). Defaults per model.
DOCINT_USD_INR=84
# Engine calls in flight at once on the worker; outbox relay attempts before a row is dead-lettered.
DOCINT_EXTRACT_CONCURRENCY=4
OUTBOX_MAX_ATTEMPTS=8
