{
  "name": "@dos/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS 12 (Fastify) modular monolith implementing the shared oRPC contract",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@dos/contracts": "workspace:*",
    "@dos/db": "workspace:*",
    "@dos/domain": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/nest": "catalog:",
    "@orpc/server": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dos/config": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
